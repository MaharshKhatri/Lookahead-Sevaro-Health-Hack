# Lookahead environment (D-93). Copy to .env; every variable is optional and
# every AWS feature degrades to the local path when unset or unreachable.
# Values shown are the defaults the code uses when the variable is absent.

# ---- demo access control (OQ-44, D-78, D-91, OQ-52) ----------------------
# true (default): the console switches to Coordinator with no PIN; inject, clock
# and reset are open. false: every command needs a role session cookie
# (POST /api/auth/session {role, pin}) and demo controls need coordinator/admin.
DEMO_MODE=true
COORDINATOR_PIN=1234
LEAD_PIN=2026
ADMIN_PIN=4321
# HMAC secret for offer/standby link tokens and session cookies. Empty = a random
# secret generated once into $LOOKAHEAD_LIVE_DIR/.secret (links survive restarts).
OFFER_LINK_SECRET=
# Token buckets per client IP per minute; 0 disables a bucket.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PHYSICIAN_PER_MIN=30
RATE_LIMIT_EVENTS_PER_MIN=60
# Space- or comma-separated origins allowed to frame /embed/* (CSP frame-ancestors).
LOOKAHEAD_EMBED_ORIGINS=
# Shared secret for the inbound event API (POST /api/v1/events, HMAC-signed bodies
# from a Synapse-like source); empty = the inbound API is disabled.
LOOKAHEAD_INGEST_SECRET=
# Comma-separated URLs that receive outbound webhooks (offer/standby state changes);
# empty = no webhooks.
LOOKAHEAD_WEBHOOK_URLS=
# demo | live: how the console labels itself and whether the sim clock controls show.
LOOKAHEAD_MODE=demo

# ---- data and storage ----------------------------------------------------
# The Sevaro package (CSVs). Default: <repo>/data/raw.
LOOKAHEAD_DATA_DIR=
# Appended events, action log, uploads and the generated secret. Default: <repo>/data/live.
LOOKAHEAD_LIVE_DIR=
# Forecast backtest JSON shown on /quality. Default: <repo>/docs/forecast_backtest.json.
LOOKAHEAD_BACKTEST_FILE=
# file (default) | dynamo. dynamo needs TABLE_NAME; any failure falls back to file.
STORE=file
TABLE_NAME=lookahead-log
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=
# DynamoDB Local / LocalStack endpoint (docker compose --profile dynamo sets http://dynamodb:8000).
AWS_ENDPOINT_URL=
# Credentials: leave empty on EC2/ECS (instance or task role). Dummy values are
# required only by DynamoDB Local.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 bucket for the audit archive on reset / dataset swap (s3:PutObject lookahead/*). Empty = no archive.
AUDIT_BUCKET=

# ---- narration (Bedrock; never in the decision path) ----------------------
# on (default) | off. off = deterministic TEMPLATE text, no Bedrock call.
NARRATION=on
# Inference profile or model id; empty = discover (Claude Haiku preferred, else Sonnet).
BEDROCK_MODEL_ID=
# Optional Amazon Bedrock Guardrail applied on the Converse call, on top of the fidelity guard.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- web server ----------------------------------------------------------
# Public origin used in QR codes and offer links (e.g. a LAN address for phones). Empty = the request's host.
LOOKAHEAD_PUBLIC_ORIGIN=
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ---- tests only ----------------------------------------------------------
# Playwright: remote target, port, live dir and the lead PIN the e2e tests type.
PLAYWRIGHT_BASE_URL=
E2E_PORT=
E2E_LIVE_DIR=
E2E_LEAD_PIN=2026
# Skip the timing benchmark tests in the engine suite.
LOOKAHEAD_SKIP_BENCH=
